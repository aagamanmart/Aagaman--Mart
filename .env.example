# All environment variables below are OPTIONAL.
# The storefront and admin panel work out of the box with built-in defaults.

# Admin console passcode (defaults to "1234" if omitted)
ADMIN_PASSCODE="1234"

# Optional: Razorpay Payment Gateway (India) — runs in Sandbox Mode if omitted
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: Email / SMS / WhatsApp notifications — runs in Sandbox Mode if omitted
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
WHATSAPP_API_TOKEN=""

# Optional: Platform-injected runtime configuration
APP_URL=""
GEMINI_API_KEY=""
