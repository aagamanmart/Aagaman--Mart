{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Verified AAGAMAN MART customer account profile synced for storefront and admin visibility.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "authMethod": {
          "type": "string",
          "enum": ["google", "email"]
        },
        "emailVerified": {
          "type": "boolean"
        },
        "phoneVerified": {
          "type": "boolean"
        },
        "isBlocked": {
          "type": "boolean"
        },
        "wishlistCount": {
          "type": "integer"
        },
        "orderCount": {
          "type": "integer"
        },
        "totalSpent": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "phone",
        "photoUrl",
        "authMethod",
        "emailVerified",
        "phoneVerified",
        "isBlocked",
        "wishlistCount",
        "orderCount",
        "totalSpent",
        "createdAt",
        "updatedAt",
        "lastLoginAt"
      ]
    },
    "StoreConfig": {
      "title": "StoreConfig",
      "description": "Public storefront configuration including store address, support email, announcement bar, and hero banners.",
      "type": "object",
      "properties": {
        "siteName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tagline": {
          "type": "string",
          "maxLength": 240
        },
        "announcementText": {
          "type": "string",
          "maxLength": 300
        },
        "announcementEnabled": {
          "type": "boolean"
        },
        "supportEmail": {
          "type": "string",
          "maxLength": 200
        },
        "supportPhone": {
          "type": "string",
          "maxLength": 40
        },
        "headquarters": {
          "type": "string",
          "maxLength": 300
        },
        "freeShippingThreshold": {
          "type": "number"
        },
        "standardShippingCharge": {
          "type": "number"
        },
        "expressShippingCharge": {
          "type": "number"
        },
        "defaultGstPercent": {
          "type": "number"
        },
        "flashSaleTitle": {
          "type": "string",
          "maxLength": 160
        },
        "flashSaleSubtitle": {
          "type": "string",
          "maxLength": 400
        },
        "banners": {
          "type": "array"
        },
        "deliveryConfig": {
          "type": "object",
          "description": "Pan-India delivery schedule days, COD toggle, dispatch cutoff note, and pincode-specific delivery rules."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "siteName",
        "tagline",
        "announcementText",
        "announcementEnabled",
        "supportEmail",
        "supportPhone",
        "headquarters",
        "freeShippingThreshold",
        "standardShippingCharge",
        "expressShippingCharge",
        "defaultGstPercent",
        "flashSaleTitle",
        "flashSaleSubtitle",
        "banners",
        "updatedAt"
      ]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Authorized store administrator registry document.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        }
      },
      "required": ["email"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support query routed to the live admin support email and admin support channel.",
      "type": "object",
      "properties": {
        "ticketId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["Open", "In Progress", "Resolved"]
        },
        "routedToEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "emailStatus": {
          "type": "string",
          "enum": ["sent", "pending_smtp", "failed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ticketId",
        "uid",
        "name",
        "email",
        "phone",
        "subject",
        "message",
        "status",
        "routedToEmail",
        "emailStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportTicketReply": {
      "title": "SupportTicketReply",
      "description": "Admin support reply stored under a support ticket and dispatched to the customer email.",
      "type": "object",
      "properties": {
        "replyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ticketId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ticketUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderRole": {
          "type": "string",
          "enum": ["admin"]
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "emailStatus": {
          "type": "string",
          "enum": ["sent", "pending_smtp", "failed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "replyId",
        "ticketId",
        "ticketUid",
        "senderRole",
        "senderName",
        "message",
        "emailStatus",
        "createdAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer e-commerce order with UPI (UTR verification) or Cash on Delivery payment details.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "customerPhone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["upi", "cod"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["cod_pending", "verification_pending", "paid", "failed"]
        },
        "utrNumber": {
          "type": "string",
          "maxLength": 12
        },
        "payableAmount": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        },
        "discountTotal": {
          "type": "number"
        },
        "couponDiscount": {
          "type": "number"
        },
        "gstTotal": {
          "type": "number"
        },
        "shippingCharge": {
          "type": "number"
        },
        "grandTotal": {
          "type": "number"
        },
        "shippingMethod": {
          "type": "string",
          "enum": ["Standard Delivery", "Express Delivery"]
        },
        "status": {
          "type": "string",
          "enum": [
            "Order Placed",
            "Payment Pending",
            "Payment Confirmed",
            "Processing",
            "Packed",
            "Shipped",
            "Out for Delivery",
            "Delivered",
            "Cancelled",
            "Returned",
            "Refunded"
          ]
        },
        "pincode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[1-9][0-9]{5}$"
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "addressLine1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "items": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderNumber",
        "uid",
        "customerName",
        "customerEmail",
        "customerPhone",
        "paymentMethod",
        "paymentStatus",
        "utrNumber",
        "payableAmount",
        "subtotal",
        "discountTotal",
        "couponDiscount",
        "gstTotal",
        "shippingCharge",
        "grandTotal",
        "shippingMethod",
        "status",
        "pincode",
        "city",
        "state",
        "addressLine1",
        "items",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Authenticated customer profile documents readable only by the owning customer or store admin."
    },
    "/storeConfig/{configId}": {
      "schema": { "$ref": "#/entities/StoreConfig" },
      "description": "Storefront configuration document at /storeConfig/main readable publicly and writable only by admin."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Admin role documents used by Firestore rules."
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Verified customer support queries readable by the ticket author or store admin, updatable only by store admin."
    },
    "/supportTickets/{ticketId}/replies/{replyId}": {
      "schema": { "$ref": "#/entities/SupportTicketReply" },
      "description": "Admin replies to a support ticket readable by the ticket author or store admin, writable only by store admin."
    },
    "/orders/{orderNumber}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Verified customer orders containing UPI/COD payment method, payable amount, and 12-digit UTR number, readable by owner or store admin."
    }
  }
}
