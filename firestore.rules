rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'utkarshjaiswar137@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidCustomer(data) {
      return data.keys().hasAll([
          'uid',
          'name',
          'email',
          'phone',
          'photoUrl',
          'authMethod',
          'emailVerified',
          'phoneVerified',
          'isBlocked',
          'wishlistCount',
          'orderCount',
          'totalSpent',
          'createdAt',
          'updatedAt',
          'lastLoginAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'phone',
          'photoUrl',
          'authMethod',
          'emailVerified',
          'phoneVerified',
          'isBlocked',
          'wishlistCount',
          'orderCount',
          'totalSpent',
          'createdAt',
          'updatedAt',
          'lastLoginAt'
        ])
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.phone is string && data.phone.size() <= 30
        && data.photoUrl is string && data.photoUrl.size() <= 1000
        && data.authMethod is string && data.authMethod in ['google', 'email']
        && data.emailVerified is bool
        && data.phoneVerified is bool
        && data.isBlocked is bool
        && data.wishlistCount is int && data.wishlistCount >= 0 && data.wishlistCount <= 10000
        && data.orderCount is int && data.orderCount >= 0 && data.orderCount <= 100000
        && data.totalSpent is number && data.totalSpent >= 0 && data.totalSpent <= 100000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidPincodeRule(rule) {
      return rule is map
        && rule.keys().hasAll([
          'pincode',
          'cityLabel',
          'serviceable',
          'deliveryDays',
          'codAvailable',
          'courierPartner',
          'note'
        ])
        && rule.keys().hasOnly([
          'pincode',
          'cityLabel',
          'serviceable',
          'deliveryDays',
          'codAvailable',
          'courierPartner',
          'note'
        ])
        && rule.pincode is string && rule.pincode.size() >= 3 && rule.pincode.size() <= 6 && rule.pincode.matches('^[1-9][0-9]{2}([0-9]{3})?$')
        && rule.cityLabel is string && rule.cityLabel.size() <= 120
        && rule.serviceable is bool
        && rule.deliveryDays is int && rule.deliveryDays >= 0 && rule.deliveryDays <= 30
        && rule.codAvailable is bool
        && rule.courierPartner is string && rule.courierPartner.size() <= 80
        && rule.note is string && rule.note.size() <= 200;
    }

    function isValidDeliveryConfig(dc) {
      return dc is map
        && dc.keys().hasAll([
          'sameHubDays',
          'standardDays',
          'remoteDays',
          'expressDays',
          'codEnabled',
          'cutoffNote',
          'pincodeRules'
        ])
        && dc.keys().hasOnly([
          'sameHubDays',
          'standardDays',
          'remoteDays',
          'expressDays',
          'codEnabled',
          'cutoffNote',
          'pincodeRules'
        ])
        && dc.sameHubDays is int && dc.sameHubDays >= 0 && dc.sameHubDays <= 30
        && dc.standardDays is int && dc.standardDays >= 0 && dc.standardDays <= 30
        && dc.remoteDays is int && dc.remoteDays >= 0 && dc.remoteDays <= 30
        && dc.expressDays is int && dc.expressDays >= 0 && dc.expressDays <= 15
        && dc.codEnabled is bool
        && dc.cutoffNote is string && dc.cutoffNote.size() <= 240
        && dc.pincodeRules is list && dc.pincodeRules.size() <= 100
        && (dc.pincodeRules.size() == 0 || isValidPincodeRule(dc.pincodeRules[0]));
    }

    function isValidStoreConfig(data) {
      return data.keys().hasAll([
          'siteName',
          'tagline',
          'announcementText',
          'announcementEnabled',
          'supportEmail',
          'supportPhone',
          'headquarters',
          'freeShippingThreshold',
          'standardShippingCharge',
          'expressShippingCharge',
          'defaultGstPercent',
          'flashSaleTitle',
          'flashSaleSubtitle',
          'banners',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'siteName',
          'tagline',
          'announcementText',
          'announcementEnabled',
          'supportEmail',
          'supportPhone',
          'headquarters',
          'freeShippingThreshold',
          'standardShippingCharge',
          'expressShippingCharge',
          'defaultGstPercent',
          'flashSaleTitle',
          'flashSaleSubtitle',
          'banners',
          'deliveryConfig',
          'updatedAt'
        ])
        && data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 120
        && data.tagline is string && data.tagline.size() <= 240
        && data.announcementText is string && data.announcementText.size() <= 300
        && data.announcementEnabled is bool
        && data.supportEmail is string && data.supportEmail.size() <= 200
        && data.supportPhone is string && data.supportPhone.size() <= 40
        && data.headquarters is string && data.headquarters.size() <= 300
        && data.freeShippingThreshold is number && data.freeShippingThreshold >= 0 && data.freeShippingThreshold <= 1000000
        && data.standardShippingCharge is number && data.standardShippingCharge >= 0 && data.standardShippingCharge <= 10000
        && data.expressShippingCharge is number && data.expressShippingCharge >= 0 && data.expressShippingCharge <= 10000
        && data.defaultGstPercent is number && data.defaultGstPercent >= 0 && data.defaultGstPercent <= 28
        && data.flashSaleTitle is string && data.flashSaleTitle.size() <= 160
        && data.flashSaleSubtitle is string && data.flashSaleSubtitle.size() <= 400
        && data.banners is list && data.banners.size() <= 10
        && (data.banners.size() == 0 || data.banners[0] is map)
        && (!('deliveryConfig' in data) || isValidDeliveryConfig(data.deliveryConfig))
        && data.updatedAt is timestamp;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll([
          'ticketId',
          'uid',
          'name',
          'email',
          'phone',
          'subject',
          'message',
          'status',
          'routedToEmail',
          'emailStatus',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ticketId',
          'uid',
          'name',
          'email',
          'phone',
          'subject',
          'message',
          'status',
          'routedToEmail',
          'emailStatus',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ticketId)
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.phone is string && data.phone.size() <= 30
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 200
        && data.message is string && data.message.size() >= 3 && data.message.size() <= 2000
        && data.status is string && data.status in ['Open', 'In Progress', 'Resolved']
        && data.routedToEmail is string && data.routedToEmail.size() >= 3 && data.routedToEmail.size() <= 200
        && data.emailStatus is string && data.emailStatus in ['sent', 'pending_smtp', 'failed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSupportTicketReply(data) {
      return data.keys().hasAll([
          'replyId',
          'ticketId',
          'ticketUid',
          'senderRole',
          'senderName',
          'message',
          'emailStatus',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'replyId',
          'ticketId',
          'ticketUid',
          'senderRole',
          'senderName',
          'message',
          'emailStatus',
          'createdAt'
        ])
        && isValidId(data.replyId)
        && isValidId(data.ticketId)
        && isValidId(data.ticketUid)
        && data.senderRole is string && data.senderRole == 'admin'
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 160
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 2000
        && data.emailStatus is string && data.emailStatus in ['sent', 'pending_smtp', 'failed']
        && data.createdAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber',
          'uid',
          'customerName',
          'customerEmail',
          'customerPhone',
          'paymentMethod',
          'paymentStatus',
          'utrNumber',
          'payableAmount',
          'subtotal',
          'discountTotal',
          'couponDiscount',
          'gstTotal',
          'shippingCharge',
          'grandTotal',
          'shippingMethod',
          'status',
          'pincode',
          'city',
          'state',
          'addressLine1',
          'items',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderNumber',
          'uid',
          'customerName',
          'customerEmail',
          'customerPhone',
          'paymentMethod',
          'paymentStatus',
          'utrNumber',
          'payableAmount',
          'subtotal',
          'discountTotal',
          'couponDiscount',
          'gstTotal',
          'shippingCharge',
          'grandTotal',
          'shippingMethod',
          'status',
          'pincode',
          'city',
          'state',
          'addressLine1',
          'items',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.orderNumber)
        && isValidId(data.uid)
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 160
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 200
        && data.customerPhone is string && data.customerPhone.size() >= 1 && data.customerPhone.size() <= 30
        && data.paymentMethod is string && data.paymentMethod in ['upi', 'cod']
        && data.paymentStatus is string && data.paymentStatus in ['cod_pending', 'verification_pending', 'paid', 'failed']
        && data.utrNumber is string && data.utrNumber.size() <= 12
        && (
          (data.paymentMethod == 'cod' && data.utrNumber == '')
          || (data.paymentMethod == 'upi' && data.utrNumber.matches('^[0-9]{12}$'))
        )
        && data.payableAmount is number && data.payableAmount > 0 && data.payableAmount <= 100000000
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 100000000
        && data.discountTotal is number && data.discountTotal >= 0 && data.discountTotal <= 100000000
        && data.couponDiscount is number && data.couponDiscount >= 0 && data.couponDiscount <= 100000000
        && data.gstTotal is number && data.gstTotal >= 0 && data.gstTotal <= 100000000
        && data.shippingCharge is number && data.shippingCharge >= 0 && data.shippingCharge <= 100000
        && data.grandTotal is number && data.grandTotal > 0 && data.grandTotal <= 100000000
        && data.payableAmount == data.grandTotal
        && data.shippingMethod is string && data.shippingMethod in ['Standard Delivery', 'Express Delivery']
        && data.status is string && data.status in [
          'Order Placed',
          'Payment Pending',
          'Payment Confirmed',
          'Processing',
          'Packed',
          'Shipped',
          'Out for Delivery',
          'Delivered',
          'Cancelled',
          'Returned',
          'Refunded'
        ]
        && data.pincode is string && data.pincode.size() == 6 && data.pincode.matches('^[1-9][0-9]{5}$')
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 120
        && data.state is string && data.state.size() >= 1 && data.state.size() <= 120
        && data.addressLine1 is string && data.addressLine1.size() >= 1 && data.addressLine1.size() <= 300
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /customers/{customerId} {
      allow get: if isSignedIn() && isValidId(customerId) && (isOwner(customerId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedUser()
        && isValidId(customerId)
        && isOwner(customerId)
        && isValidCustomer(incoming())
        && incoming().uid == request.auth.uid
        && incoming().uid == customerId
        && incoming().email == request.auth.token.email
        && incoming().isBlocked == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastLoginAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(customerId)
        && isValidCustomer(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().authMethod == existing().authMethod
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isBlocked', 'updatedAt']))
          || (
            isOwner(customerId)
            && incoming().isBlocked == existing().isBlocked
            && incoming().lastLoginAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'phone',
              'photoUrl',
              'emailVerified',
              'phoneVerified',
              'wishlistCount',
              'orderCount',
              'totalSpent',
              'lastLoginAt',
              'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /storeConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'main';
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(configId)
        && configId == 'main'
        && isValidStoreConfig(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(configId)
        && configId == 'main'
        && isValidStoreConfig(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && resource.data.uid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(ticketId)
        && isValidSupportTicket(incoming())
        && incoming().ticketId == ticketId
        && incoming().uid == request.auth.uid
        && incoming().status == 'Open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(ticketId)
        && isValidSupportTicket(incoming())
        && isAdmin()
        && incoming().ticketId == existing().ticketId
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;

      match /replies/{replyId} {
        allow get: if isValidId(ticketId)
          && isValidId(replyId)
          && (isAdmin() || (isVerifiedUser() && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid));
        allow list: if isValidId(ticketId)
          && (isBootstrappedAdmin() || (isVerifiedUser() && resource.data.ticketUid == request.auth.uid));
        allow create: if isAdmin()
          && isValidId(ticketId)
          && isValidId(replyId)
          && isValidSupportTicketReply(incoming())
          && exists(/databases/$(database)/documents/supportTickets/$(ticketId))
          && incoming().replyId == replyId
          && incoming().ticketId == ticketId
          && incoming().ticketUid == get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /orders/{orderNumber} {
      allow get: if isValidId(orderNumber) && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && resource.data.uid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(orderNumber)
        && isValidOrder(incoming())
        && incoming().orderNumber == orderNumber
        && incoming().uid == request.auth.uid
        && incoming().status == 'Order Placed'
        && (
          (incoming().paymentMethod == 'cod' && incoming().paymentStatus == 'cod_pending')
          || (incoming().paymentMethod == 'upi' && incoming().paymentStatus == 'verification_pending')
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(orderNumber)
        && isValidOrder(incoming())
        && incoming().orderNumber == existing().orderNumber
        && incoming().uid == existing().uid
        && incoming().paymentMethod == existing().paymentMethod
        && incoming().utrNumber == existing().utrNumber
        && incoming().grandTotal == existing().grandTotal
        && incoming().payableAmount == existing().payableAmount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt']))
          || (
            existing().uid == request.auth.uid
            && existing().status in ['Order Placed', 'Payment Pending']
            && incoming().status == 'Cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }
  }
}
